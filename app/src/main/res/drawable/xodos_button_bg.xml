<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/xodos_button_pressed" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/xodos_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/xodos_surface"
                android:endColor="@color/xodos_bg_secondary" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/xodos_border" />
        </shape>
    </item>
</selector>
